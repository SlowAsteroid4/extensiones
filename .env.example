# Copia este archivo a .env — valores de DESARROLLO local, nunca de producción.
DATABASE_URL="postgresql://extensiones:extensiones_dev@localhost:5432/extensiones"

# Postgres local (docker-compose los lee)
POSTGRES_USER=extensiones
POSTGRES_PASSWORD=extensiones_dev
POSTGRES_DB=extensiones

# Auth.js — genera uno propio: `openssl rand -base64 32`
AUTH_SECRET=dev-secret-cambiame-0000000000000000000000

# Cuenta admin que crea el seed (solo desarrollo)
SEED_ADMIN_EMAIL=admin@extensiones.local
SEED_ADMIN_PASSWORD=admin-dev-cambiame-1234
SEED_ADMIN_NOMBRE=Admin Dev
