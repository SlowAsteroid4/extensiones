# Copia este archivo a .env — valores de DESARROLLO local, nunca de producción.
# Los valores de producción viven SOLO en las variables de entorno de Vercel.
# Ver README §Producción para qué se carga en Vercel y qué no.

# ─────────────────────────────────────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────────────────────────────────────
# DESARROLLO: Postgres local de docker-compose.
# PRODUCCIÓN (Vercel): la cadena POOLED de Neon — el host lleva "-pooler".
#   Es la que abre la app en cada invocación serverless.
DATABASE_URL="postgresql://extensiones:extensiones_dev@localhost:5432/extensiones"

# Cadena DIRECTA de Neon (host SIN "-pooler"). La usa SOLO la CLI de Prisma
# (`prisma migrate deploy`): el pooler en modo transacción rompe el DDL.
# En local se deja vacía: prisma.config.ts cae a DATABASE_URL.
DIRECT_URL=

# Postgres local (docker-compose los lee) — no existen en producción.
POSTGRES_USER=extensiones
POSTGRES_PASSWORD=extensiones_dev
POSTGRES_DB=extensiones

# ─────────────────────────────────────────────────────────────────────────────
# Auth.js
# ─────────────────────────────────────────────────────────────────────────────
# Firma la cookie de sesión JWT. En producción va uno DISTINTO y nuevo:
#   `openssl rand -base64 32`
# No hace falta AUTH_URL/NEXTAUTH_URL: la config usa trustHost y la deduce del host.
AUTH_SECRET=dev-secret-cambiame-0000000000000000000000

# Alta de cuenta: contrasta la contraseña contra el corpus público de
# filtraciones (Have I Been Pwned, API k-anonymity — solo viajan los 5 primeros
# caracteres del SHA-1, nunca la contraseña). "on" para activarlo; cualquier
# otro valor lo deja apagado. Si el servicio no responde, el alta continúa.
# Producción: "on".
PWNED_PASSWORDS_CHECK=off

# ─────────────────────────────────────────────────────────────────────────────
# Pasarela de pago
# ─────────────────────────────────────────────────────────────────────────────
# "fake" mientras no existan credenciales reales de MercadoPago (T8 despliega
# así); "mercadopago" en cuanto el dueño entregue el token — T10 es SOLO cambiar
# estas tres variables en Vercel y redesplegar, no se toca código.
PASARELA_PROVIDER=fake
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del panel de webhooks de MP. Valor de FIXTURE local para Fase A;
# el real llega con las credenciales.
MERCADOPAGO_WEBHOOK_SECRET=test-secret-local-only

# ─────────────────────────────────────────────────────────────────────────────
# URL pública
# ─────────────────────────────────────────────────────────────────────────────
# Base de notification_url/back_urls de MercadoPago y del init_point del
# provider fake. Resolución en src/shared/config/app-url.ts:
#   APP_URL → https://$VERCEL_URL → http://localhost:3000
# Producción: la URL *.vercel.app; cuando llegue el dominio (T11) SOLO cambia aquí.
APP_URL=http://localhost:3000

# WhatsApp de la tienda (CTA de dudas del layout público y coordinación de
# entrega en la confirmación). Formato E.164 sin "+", ej. 5215512345678.
# Si falta, el botón de WhatsApp NO se muestra. NEXT_PUBLIC_* se incrusta en el
# bundle del navegador: nunca pongas secretos con ese prefijo.
NEXT_PUBLIC_WHATSAPP_NUMERO=5215512345678

# ─────────────────────────────────────────────────────────────────────────────
# Seeds — NO se cargan en Vercel
# ─────────────────────────────────────────────────────────────────────────────
# Las lee `npm run db:seed` (desarrollo) y `npm run db:seed-produccion`, que se
# corren a mano desde una máquina. La app en runtime nunca las usa, así que la
# contraseña de la admin de producción NO tiene por qué vivir en Vercel.
SEED_ADMIN_EMAIL=admin@extensiones.local
SEED_ADMIN_PASSWORD=admin-dev-cambiame-1234
SEED_ADMIN_NOMBRE=Admin Dev
